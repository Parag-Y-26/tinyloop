{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tinyloop",
  "version": "0.1.0",
  "identifier": "com.tinyloop.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "tinyloop", "width": 1440, "height": 920, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "targets": "all" }
}
